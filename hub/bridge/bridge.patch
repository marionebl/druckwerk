+        let c = open_live(addr, "SER123").await;
+        // Same serial: fail fast with 409. Other serial: unaffected.
+        let busy = server.get("/camera/SER123/snapshot").await;
+        println!("same serial: HTTP {} {}", busy.status_code(), busy.text());
+        busy.assert_status(StatusCode::CONFLICT);
+        assert_eq!(busy.json::<Value>()["stage"], "busy");
+        let busy2 = server.get("/camera/SER123/live").await;
+        busy2.assert_status(StatusCode::CONFLICT);
+        let other = server.get("/camera/SER456/snapshot").await;
+        println!("other serial: HTTP {}", other.status_code());
+        other.assert_status_ok();
+        // Once the live client is gone the serial is free again.
+        drop(c);
+        let t0 = std::time::Instant::now();
+        loop {
+            let r = server.get("/camera/SER123/snapshot").await;
+            if r.status_code() == StatusCode::OK {
+                break;
+            }
+            assert!(t0.elapsed() < Duration::from_secs(5), "serial still busy: {}", r.text());
+            tokio::time::sleep(Duration::from_millis(50)).await;
+        }
+    }
