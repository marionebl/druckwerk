+    /// Open a live request and read until the headers plus some body arrived.
+    async fn open_live(addr: std::net::SocketAddr, serial: &str) -> tokio::net::TcpStream {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let mut c = tokio::net::TcpStream::connect(addr).await.unwrap();
+        c.write_all(format!("GET /camera/{serial}/live HTTP/1.1\r\nHost: t\r\n\r\n").as_bytes()).await.unwrap();
+        let mut got = Vec::new();
+        let mut buf = [0u8; 4096];
+        while !(got.windows(4).any(|w| w == b"\r\n\r\n") && got.len() > 300) {
+            let n = tokio::time::timeout(Duration::from_secs(10), c.read(&mut buf)).await.expect("no data").unwrap();
+            assert!(n > 0, "closed early: {}", String::from_utf8_lossy(&got));
+            got.extend_from_slice(&buf[..n]);
+        }
+        assert!(String::from_utf8_lossy(&got).starts_with("HTTP/1.1 200"), "{}", String::from_utf8_lossy(&got[..100]));
+        c
+    }
