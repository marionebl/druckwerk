+// ---------------------------------------------------------------------------
+// Camera URL
+// ---------------------------------------------------------------------------
+
+typedef void (*shim_camera_url_cb)(void* ctx, const char* url);
+
+/// Starts an asynchronous camera URL request. The URL (or an error string such
+/// as "...[code]") is delivered via cb(ctx, url) from a library thread.
+/// Returns the .so's return value, or -1 if the symbol is not available.
+int shim_get_camera_url(void* agent, const char* dev_id, shim_camera_url_cb cb, void* ctx) {
+    if (!fp_get_camera_url) return -1;
+    std::function<void(std::string)> wrapper = [cb, ctx](std::string url) {
+        if (cb) cb(ctx, url.c_str());
+    };
+    return fp_get_camera_url(agent, std::string(dev_id), wrapper);
+}
+
+// ---------------------------------------------------------------------------
+// Snapshot via libBambuSource.so (BambuTunnel API, see BambuTunnel.h)
+// ---------------------------------------------------------------------------
+
+typedef void* Bambu_Tunnel;
+typedef void (*BambuLogger)(void* context, int level, const char* msg);
+
+struct BambuStreamInfo {
+    int type;
+    int sub_type;
+    int width;     // union format.video.{width,height,frame_rate} / audio
+    int height;
+    int frame_rate;
+    int format_type;
+    int format_size;
+    int max_frame_size;
+    unsigned char const* format_buffer;
+};
+
+struct BambuSample {
+    int itrack;
+    int size;
+    int flags;
+    unsigned char const* buffer;
+    unsigned long long decode_time;
+};
+
+typedef int  (*bs_create)(Bambu_Tunnel*, const char*);
+typedef void (*bs_set_logger)(Bambu_Tunnel, BambuLogger, void*);
+typedef int  (*bs_open)(Bambu_Tunnel);
+typedef int  (*bs_start_stream)(Bambu_Tunnel, bool);
+typedef int  (*bs_get_stream_info)(Bambu_Tunnel, int, BambuStreamInfo*);
+typedef int  (*bs_read_sample)(Bambu_Tunnel, BambuSample*);
+typedef void (*bs_close)(Bambu_Tunnel);
+typedef void (*bs_destroy)(Bambu_Tunnel);
+typedef void (*bs_free_log)(const char*);
+
+// Stages (also reported to Rust through stage_out as they are entered).
+enum { ST_NONE = 0, ST_DLOPEN = 1, ST_CREATE = 2, ST_OPEN = 3, ST_START = 4, ST_INFO = 5, ST_READ = 6, ST_DONE = 7 };
+
+struct ShimSnapResult {
+    int stage;          // stage that failed (or ST_DONE on success)
+    int code;           // return code of the failing call (0 on success)
+    int ok;
+    int sub_type;       // 0 = H.264, 1 = MJPEG
+    int format_type;    // 0 avc_packet, 1 avc_byte_stream, 2 jpeg
+    int width, height, frame_rate;
+    int sample_flags;
+    unsigned char* data;     // malloc'd, free with shim_snapshot_free
+    int data_len;
+    unsigned char* fmt;      // copy of format_buffer (avcC or SPS/PPS), may be null
+    int fmt_len;
+    char err[256];
+};
+
+// Per-call logger context. Deliberately leaked (a few bytes per call): the
+// library may log from its own threads after we return, so it must stay valid;
+// `cb` is cleared on return so late lines are dropped.
+struct SnapLog {
+    void (*volatile cb)(void*, int, const char*);
+    void* ctx;
+    bs_free_log free_log;
+};
+
+static void snap_logger(void* p, int level, const char* msg) {
+    if (!msg) return;
+    auto* l = (SnapLog*)p;
+    auto cb = l->cb;
+    if (cb) cb(l->ctx, level, msg);
+    if (l->free_log) l->free_log(msg);
+}
+
+static void snap_set_stage(int* stage_out, ShimSnapResult* r, int st) {
+    r->stage = st;
+    if (stage_out) __atomic_store_n(stage_out, st, __ATOMIC_RELEASE);
+}
+
+static void snap_fail(ShimSnapResult* r, int st, int code, const char* msg) {
+    r->stage = st;
+    r->code = code;
+    r->ok = 0;
+    std::strncpy(r->err, msg, sizeof(r->err) - 1);
+    r->err[sizeof(r->err) - 1] = 0;
+}
+
+void shim_snapshot_free(ShimSnapResult* r) {
+    if (!r) return;
+    free(r->data); r->data = nullptr; r->data_len = 0;
+    free(r->fmt);  r->fmt = nullptr;  r->fmt_len = 0;
+}
+
+struct SrcFns {
+    bs_create create; bs_set_logger logger; bs_open open; bs_start_stream start;
+    bs_get_stream_info info; bs_read_sample read; bs_close close; bs_destroy destroy;
+};
+
+// Shared by snapshot and live: dlopen .. GetStreamInfo. On failure r is filled
+// and the caller must still close/destroy via `t`/`is_open`.
+static bool src_open(
+    const char* lib_path, const char* url, SrcFns& f, SnapLog* sl,
+    std::chrono::steady_clock::time_point deadline,
+    ShimSnapResult* r, int* stage_out, Bambu_Tunnel& t, int& is_open
+) {
+    snap_set_stage(stage_out, r, ST_DLOPEN);
+    void* lib = dlopen(lib_path, RTLD_LAZY);
+    if (!lib) {
+        const char* e = dlerror();
+        snap_fail(r, ST_DLOPEN, -2, e ? e : "dlopen failed");
+        return false;
+    }
+    f.create = (bs_create)dlsym(lib, "Bambu_Create");
+    f.logger = (bs_set_logger)dlsym(lib, "Bambu_SetLogger");
+    f.open   = (bs_open)dlsym(lib, "Bambu_Open");
+    f.start  = (bs_start_stream)dlsym(lib, "Bambu_StartStream");
+    f.info   = (bs_get_stream_info)dlsym(lib, "Bambu_GetStreamInfo");
+    f.read   = (bs_read_sample)dlsym(lib, "Bambu_ReadSample");
+    f.close  = (bs_close)dlsym(lib, "Bambu_Close");
+    f.destroy = (bs_destroy)dlsym(lib, "Bambu_Destroy");
+    sl->free_log = (bs_free_log)dlsym(lib, "Bambu_FreeLogMsg");
+    if (!f.create || !f.logger || !f.open || !f.start || !f.info || !f.read || !f.close || !f.destroy) {
+        snap_fail(r, ST_DLOPEN, -3, "libBambuSource is missing required Bambu_* symbols");
+        return false;  // keep library loaded: never dlclose a lib with live threads
+    }
+
+    snap_set_stage(stage_out, r, ST_CREATE);
+    int ret = f.create(&t, url);
+    if (ret != 0 || !t) { snap_fail(r, ST_CREATE, ret ? ret : -1, "Bambu_Create failed"); return false; }
+    f.logger(t, snap_logger, sl);
+
+    snap_set_stage(stage_out, r, ST_OPEN);
+    ret = f.open(t);
+    if (ret != 0) { snap_fail(r, ST_OPEN, ret, "Bambu_Open failed"); return false; }
+    is_open = 1;
+
+    snap_set_stage(stage_out, r, ST_START);
+    while (true) {
+        ret = f.start(t, true);
+        if (ret != 2 /* would_block */) break;
+        if (std::chrono::steady_clock::now() >= deadline) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    if (ret != 0) {
+        snap_fail(r, ST_START, ret, ret == 2 ? "Bambu_StartStream kept blocking until timeout" : "Bambu_StartStream failed");
+        return false;
+    }
+
+    snap_set_stage(stage_out, r, ST_INFO);
+    BambuStreamInfo info;
+    std::memset(&info, 0, sizeof(info));
+    ret = f.info(t, 0, &info);
+    if (ret != 0) { snap_fail(r, ST_INFO, ret, "Bambu_GetStreamInfo failed"); return false; }
+    r->sub_type = info.sub_type;
+    r->format_type = info.format_type;
+    r->width = info.width;
+    r->height = info.height;
+    r->frame_rate = info.frame_rate;
+    if (info.format_buffer && info.format_size > 0 && info.format_size < (1 << 20)) {
+        r->fmt = (unsigned char*)malloc(info.format_size);
+        if (r->fmt) { std::memcpy(r->fmt, info.format_buffer, info.format_size); r->fmt_len = info.format_size; }
+    }
+    snap_set_stage(stage_out, r, ST_READ);
+    return true;
+}
+
+/// Blocking: dlopen libBambuSource, run the play loop until the first
+/// keyframe (or JPEG), copy it into r->data. Never logs or returns `url`.
+/// Safe to run concurrently for different tunnels (logger state is per call).
+int shim_snapshot(
+    const char* lib_path, const char* url, int timeout_ms,
+    ShimSnapResult* r, int* stage_out,
+    void (*log_cb)(void*, int, const char*), void* log_ctx
+) {
+    std::memset(r, 0, sizeof(*r));
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+    auto expired = [&]() { return std::chrono::steady_clock::now() >= deadline; };
+
+    SrcFns f{};
+    auto* sl = new SnapLog{log_cb, log_ctx, nullptr};
+    Bambu_Tunnel t = nullptr;
+    int is_open = 0;
+
+    do {
+        if (!src_open(lib_path, url, f, sl, deadline, r, stage_out, t, is_open)) break;
+
+        const bool is_jpeg = (r->sub_type == 1);
+        int last = 0;
+        while (true) {
+            if (expired()) {
+                snap_fail(r, ST_READ, last, "timeout waiting for first keyframe");
+                break;
+            }
+            BambuSample s;
+            std::memset(&s, 0, sizeof(s));
+            last = f.read(t, &s);
+            if (last == 0) {
+                // MJPEG: every frame is self-contained, accept the first one.
+                if ((s.flags & 1) || is_jpeg) {
+                    if (s.size <= 0 || !s.buffer) { snap_fail(r, ST_READ, -4, "empty sample"); break; }
+                    r->data = (unsigned char*)malloc(s.size);
+                    if (!r->data) { snap_fail(r, ST_READ, -5, "out of memory"); break; }
+                    std::memcpy(r->data, s.buffer, s.size);
+                    r->data_len = s.size;
+                    r->sample_flags = s.flags;
+                    r->ok = 1;
+                    r->code = 0;
+                    snap_set_stage(stage_out, r, ST_DONE);
+                    break;
+                }
+                continue;  // delta frame, keep reading
+            } else if (last == 2 /* would_block */) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                continue;
+            } else if (last == 1 /* stream_end */) {
+                snap_fail(r, ST_READ, last, "stream ended before a keyframe arrived");
+                break;
+            } else {
+                snap_fail(r, ST_READ, last, "Bambu_ReadSample failed");
+                break;
+            }
+        }
+    } while (false);
+
+    if (is_open) f.close(t);
+    if (t) f.destroy(t);
+    sl->cb = nullptr;
+    // Intentionally no dlclose: the library owns background threads.
+    return r->ok ? 0 : -1;
+}
+
+/// Blocking live play loop. `on_info` is called once with the stream info (r
+/// with sub_type/format/fmt filled), then `on_sample` per sample; a non-zero
+/// return from either, or *stop != 0, ends the loop. `timeout_ms` bounds the
+/// open phase and the gap between delivered samples. On return r->ok is 1 for
+/// a normal end (stop/stream end/callback), 0 with stage/code/err on failure.
+/// The tunnel is always closed and destroyed before returning.
+int shim_stream(
+    const char* lib_path, const char* url, int timeout_ms,
+    ShimSnapResult* r, int* stage_out, const int* stop,
+    void (*log_cb)(void*, int, const char*), void* log_ctx,
+    int (*on_info)(void*, const ShimSnapResult*),
+    int (*on_sample)(void*, const unsigned char*, int, int), void* cb_ctx
+) {
+    std::memset(r, 0, sizeof(*r));
+    auto now = []() { return std::chrono::steady_clock::now(); };
+    auto gap = std::chrono::milliseconds(timeout_ms);
+    auto deadline = now() + gap;
+    auto stopped = [&]() { return __atomic_load_n(stop, __ATOMIC_ACQUIRE) != 0; };
+
+    SrcFns f{};
+    auto* sl = new SnapLog{log_cb, log_ctx, nullptr};
+    Bambu_Tunnel t = nullptr;
+    int is_open = 0;
+
+    do {
+        if (!src_open(lib_path, url, f, sl, deadline, r, stage_out, t, is_open)) break;
+        if (on_info(cb_ctx, r)) { r->ok = 1; break; }
+
+        int last = 0;
+        while (!stopped()) {
+            if (now() >= deadline) {
+                snap_fail(r, ST_READ, last, "timeout waiting for samples");
+                break;
+            }
+            BambuSample s;
+            std::memset(&s, 0, sizeof(s));
+            last = f.read(t, &s);
+            if (last == 0) {
+                if (s.size <= 0 || !s.buffer) continue;
+                deadline = now() + gap;
+                if (on_sample(cb_ctx, s.buffer, s.size, s.flags)) { r->ok = 1; break; }
+            } else if (last == 2 /* would_block */) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(10));
+            } else if (last == 1 /* stream_end */) {
+                r->ok = 1;
+                break;
+            } else {
+                snap_fail(r, ST_READ, last, "Bambu_ReadSample failed");
+                break;
+            }
+        }
+        if (!r->err[0] && stopped()) r->ok = 1;
+    } while (false);
+
+    if (is_open) f.close(t);
+    if (t) f.destroy(t);
+    sl->cb = nullptr;
+    return r->ok ? 0 : -1;
+}
+
 } // extern "C"
