+/// POST /command/:device_id — publish one MQTT message (the request body) the way BambuStudio's
+/// cloud_publish_json does. The plugin signs it where the firmware requires that.
+async fn send_command(
+    State(state): State<SharedState>,
+    Path(device_id): Path<String>,
+    Json(payload): Json<serde_json::Value>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ErrorResponse>)> {
+    if !payload.is_object() {
+        return Err(err(StatusCode::BAD_REQUEST, "body must be a JSON object".into()));
+    }
+    // The SDK requires the device to be selected before send_message works (-2 otherwise).
+    let _ = state
+        .handle
+        .subscribe_and_pushall(device_id.clone(), std::time::Duration::from_secs(10))
+        .await;
+    let ret = state
+        .handle
+        .send_message(device_id.clone(), payload.to_string())
+        .await
+        .map_err(|e| err(StatusCode::BAD_REQUEST, format!("invalid device_id: {e}")))?;
+    if ret != 0 {
+        return Err(err(StatusCode::BAD_GATEWAY, format!("send_message returned {ret}")));
+    }
+    Ok(Json(serde_json::json!({"device_id": device_id, "sent": true})))
+}
