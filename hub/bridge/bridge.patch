+//! Camera support: mint a Bambu camera URL and grab one still frame.
+//!
+//! Routes (registered in `server::router`):
+//!   GET /camera/:serial/url       -> {"ok","url_prefix","transport","protocols","ipcam",...}
+//!   GET /camera/:serial/snapshot  -> image/jpeg (MJPEG) or video/h264 (Annex-B keyframe),
+//!                                    or 502 {"error","stage","code","log"}
+//!   GET /camera/:serial/live      -> continuous stream: video/h264 (Annex-B) or
+//!                                    multipart/x-mixed-replace (MJPEG); same errors
+//!
+//! SECURITY: the minted URL carries credentials (authkey, passwd, ...). It is
+//! never returned, never logged, and library log lines are redacted before
+//! they are stored or returned.
+
+use std::collections::{HashMap, VecDeque};
+use std::ffi::{CStr, CString};
+use std::os::raw::{c_char, c_int, c_void};
+use std::sync::atomic::{AtomicBool, AtomicI32, Ordering};
+use std::sync::{Arc, Mutex, RwLock};
+use std::time::Duration;
+
+use axum::body::{Body, Bytes};
+use axum::extract::{Path, Query, State};
+use axum::http::{header, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Json, Response};
+use serde_json::{json, Value};
+use tokio::sync::{oneshot, Notify};
+
+use crate::agent::{BambuAgent, BAMBU_STUDIO_VERSION};
+use crate::ffi;
+use crate::server::SharedState;
+
+pub const MINT_TIMEOUT: Duration = Duration::from_secs(20);
+pub const SNAPSHOT_TIMEOUT: Duration = Duration::from_secs(45);
+/// Extra grace on top of SNAPSHOT_TIMEOUT before the helper thread is declared hung.
+const HELPER_GRACE: Duration = Duration::from_secs(15);
+const LOG_KEEP: usize = 200;
+const LOG_RETURN: usize = 20;
+
+// ---------------------------------------------------------------------------
+// State
+// ---------------------------------------------------------------------------
+
+#[derive(Default)]
+pub struct CameraState {
+    /// Path of libbambu_networking.so as given to the bridge (host-visible,
+    /// i.e. the same string dlopen gets). libBambuSource.so lives next to it.
+    pub lib_path: Mutex<String>,
+    /// serial -> firmware (ota) version, scraped from `info.module` MQTT replies.
+    pub versions: RwLock<HashMap<String, String>>,
+    /// Per-serial play-loop state: serials do not block each other (the shim
+    /// keeps logger state per call).
+    slots: Mutex<HashMap<String, Arc<SerialSlot>>>,
+    /// Test hook: pretend the cloud returned this URL.
+    #[cfg(test)]
+    pub test_url: Mutex<Option<String>>,
+}
+
+/// One printer's camera: snapshots are serialised by `lock`; `live` (only set
+/// under `lock`) marks a running live stream.
+#[derive(Default)]
+struct SerialSlot {
+    lock: tokio::sync::Mutex<()>,
+    live: AtomicBool,
+}
+
+impl CameraState {
+    fn slot(&self, serial: &str) -> Arc<SerialSlot> {
+        self.slots.lock().unwrap().entry(serial.to_string()).or_default().clone()
+    }
+
+    pub fn set_lib_path(&self, p: &str) {
+        *self.lib_path.lock().unwrap() = p.to_string();
+    }
+
+    pub fn bambu_source_path(&self) -> String {
+        let lp = self.lib_path.lock().unwrap().clone();
+        bambu_source_path_for(&lp)
+    }
+}
+
+/// `<dir of networking lib>/libBambuSource.so`, string manipulation only (no
+/// stat: qemu 11 does not apply `-L` to statx, dlopen reports failures itself).
+pub fn bambu_source_path_for(networking_lib: &str) -> String {
+    match std::path::Path::new(networking_lib).parent() {
+        Some(d) if !d.as_os_str().is_empty() => format!("{}/libBambuSource.so", d.display()),
+        _ => "libBambuSource.so".to_string(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Redaction
+// ---------------------------------------------------------------------------
+
+const SENSITIVE_KEYS: &[&str] = &[
+    "authkey", "passwd", "password", "token", "license", "uid", "channel", "cli_id",
+    "refresh_url", "sign", "secret",
+];
+
+fn is_delim(c: char) -> bool {
+    c.is_whitespace() || matches!(c, '"' | '\'' | ',' | ';' | ')' | '(' | '<' | '>' | '[' | ']' | '{' | '}')
+}
+
+/// Remove URL query strings and credential-looking `key=value` pairs from a log line.
+pub fn redact(line: &str) -> String {
+    // 1. Cut every query string: "?....." up to the next delimiter.
+    let mut out = String::with_capacity(line.len());
+    let mut chars = line.chars().peekable();
+    while let Some(c) = chars.next() {
+        if c == '?' && chars.peek().map(|n| !is_delim(*n)).unwrap_or(false) {
+            out.push_str("?<redacted>");
+            while let Some(n) = chars.peek() {
+                if is_delim(*n) {
+                    break;
+                }
+                chars.next();
+            }
+        } else {
+            out.push(c);
+        }
+    }
+    // 2. Mask `key=value` for sensitive keys that appear outside a query string.
+    let mut res = out;
+    for key in SENSITIVE_KEYS {
+        let needle = format!("{key}=");
+        let mut search_from = 0;
+        while let Some(rel) = res[search_from..].to_ascii_lowercase().find(&needle) {
+            let start = search_from + rel;
+            let val_start = start + needle.len();
+            let val_end = res[val_start..]
+                .find(|c: char| is_delim(c) || c == '&')
+                .map(|i| val_start + i)
+                .unwrap_or(res.len());
+            if &res[val_start..val_end] == "<redacted>" {
+                search_from = val_end;
+                continue;
+            }
+            res.replace_range(val_start..val_end, "<redacted>");
+            search_from = val_start + "<redacted>".len();
+        }
+    }
+    if res.len() > 500 {
+        let mut cut = 500;
+        while !res.is_char_boundary(cut) {
+            cut -= 1;
+        }
+        res.truncate(cut);
+        res.push_str("...");
+    }
+    res
+}
+
+/// Only the part of a camera URL before '?': e.g. `bambu:///tutk`.
+pub fn url_prefix(url: &str) -> String {
+    url.split('?').next().unwrap_or("").to_string()
+}
+
+/// `bambu:///tutk` -> `tutk`
+pub fn transport_of(prefix: &str) -> String {
+    prefix
+        .strip_prefix("bambu:///")
+        .unwrap_or("")
+        .trim_end_matches('/')
+        .to_string()
+}
+
+// ---------------------------------------------------------------------------
+// Status helpers
+// ---------------------------------------------------------------------------
+
+/// The printer's `ipcam` object (usually `print.ipcam`).
+pub fn ipcam_of(status: &Value) -> Value {
+    status
+        .get("print")
+        .and_then(|p| p.get("ipcam"))
+        .or_else(|| status.get("ipcam"))
+        .cloned()
+        .unwrap_or(Value::Null)
+}
+
+/// Protocol list from `ipcam.liveview.remote`, mapped like BambuStudio's
+/// `remote_protos` ("none","tutk","agora","tutk_agaro"); default tutk+agora.
+pub fn protocols_from_ipcam(ipcam: &Value) -> Vec<String> {
+    let remote = ipcam
+        .get("liveview")
+        .and_then(|l| l.get("remote"))
+        .and_then(|r| r.as_str())
+        .unwrap_or("none");
+    match remote {
+        "tutk" => vec!["tutk".into()],
+        "agora" => vec!["agora".into()],
+        "tutk_agora" | "tutk_agaro" => vec!["tutk".into(), "agora".into()],
+        _ => vec!["tutk".into(), "agora".into()],
+    }
+}
+
+/// Protocol list as it must appear in dev_id: `"tutk","agora"` (quotes included).
+pub fn protocols_wire(p: &[String]) -> String {
+    p.iter().map(|s| format!("\"{s}\"")).collect::<Vec<_>>().join(",")
+}
+
+/// Parse a user supplied `?protocols=tutk,agora` override.
+fn parse_protocol_override(s: &str) -> Vec<String> {
+    s.split(',')
+        .map(|x| x.trim().trim_matches('"').to_string())
+        .filter(|x| matches!(x.as_str(), "tutk" | "agora"))
+        .collect()
+}
+
+/// Firmware version if present: `info.module[name=ota].sw_ver`, else a few
+/// `upgrade_state`/`print` fields. Returns None when not present.
+pub fn extract_dev_ver(v: &Value) -> Option<String> {
+    let nonempty = |x: &Value| x.as_str().filter(|s| !s.is_empty()).map(|s| s.to_string());
+    if let Some(mods) = v.get("info").and_then(|i| i.get("module")).and_then(|m| m.as_array()) {
+        for m in mods {
+            if m.get("name").and_then(|n| n.as_str()) == Some("ota") {
+                if let Some(s) = m.get("sw_ver").and_then(nonempty) {
+                    return Some(s);
+                }
+            }
+        }
+    }
+    let print = v.get("print").unwrap_or(v);
+    if let Some(us) = print.get("upgrade_state") {
+        for k in ["sw_ver", "cur_ver", "version", "ota_version"] {
+            if let Some(s) = us.get(k).and_then(nonempty) {
+                return Some(s);
+            }
+        }
+    }
+    print.get("sw_ver").and_then(nonempty)
+}
+
+// ---------------------------------------------------------------------------
+// URL minting
+// ---------------------------------------------------------------------------
+
+struct MintCtx {
+    tx: Mutex<Option<oneshot::Sender<Result<String, String>>>>,
+}
+
+extern "C" fn mint_callback(ctx: *mut c_void, url: *const c_char) {
+    // ctx is a leaked Box<MintCtx> (the library may call back late or never,
+    // so it is deliberately never freed: 1 small allocation per mint).
+    let ctx = unsafe { &*(ctx as *const MintCtx) };
+    let s = if url.is_null() {
+        String::new()
+    } else {
+        unsafe { CStr::from_ptr(url).to_string_lossy().into_owned() }
+    };
+    if let Some(tx) = ctx.tx.lock().unwrap().take() {
+        let r = if s.starts_with("bambu:///") {
+            Ok(s)
+        } else {
+            // Error text such as "...[code]". Redact defensively, never log.
+            Err(redact(&s))
+        };
+        let _ = tx.send(r);
+    }
+}
+
+/// Runs on the agent thread: start the async request and return immediately.
+pub fn start_mint(
+    agent: &BambuAgent,
+    dev_id: &str,
+    reply: oneshot::Sender<Result<String, String>>,
+) {
+    if unsafe { ffi::bambu_shim_has_camera_url() } == 0 {
+        let _ = reply.send(Err(
+            "libbambu_networking.so has no bambu_network_get_camera_url symbol".into(),
+        ));
+        return;
+    }
+    let ctx = Box::into_raw(Box::new(MintCtx { tx: Mutex::new(Some(reply)) }));
+    match agent.get_camera_url(dev_id, mint_callback, ctx as *mut c_void) {
+        Ok(ret) => {
+            // dev_id has no credentials (serial|version|protocols): safe to log.
+            tracing::info!(ret, "get_camera_url submitted");
+        }
+        Err(e) => {
+            let ctx = unsafe { &*ctx };
+            if let Some(tx) = ctx.tx.lock().unwrap().take() {
+                let _ = tx.send(Err(e));
+            }
+        }
+    }
+}
+
+pub struct MintOk {
+    /// Full URL (credentials!). Never log or return.
+    url: String,
+    pub dev_ver: String,
+    pub protocols: Vec<String>,
+    pub ipcam: Value,
+}
+
+pub struct MintErr {
+    pub error: String,
+    pub ipcam: Value,
+    pub protocols: Vec<String>,
+}
+
+async fn mint(
+    state: &SharedState,
+    serial: &str,
+    protocols_override: Option<Vec<String>>,
+) -> Result<MintOk, MintErr> {
+    #[cfg(test)]
+    {
+        let t = state.camera.test_url.lock().unwrap().clone();
+        if let Some(url) = t {
+            return Ok(MintOk {
+                url,
+                dev_ver: "01.00.00.00".into(),
+                protocols: vec!["tutk".into(), "agora".into()],
+                ipcam: json!({"liveview": {"remote": "tutk"}}),
+            });
+        }
+    }
+
+    let fail = |error: String, ipcam: Value, protocols: Vec<String>| MintErr { error, ipcam, protocols };
+
+    if serial.is_empty() || serial.contains(['|', '/', '"']) {
+        return Err(fail("invalid serial".into(), Value::Null, vec![]));
+    }
+
+    let status = crate::server::get_printer_status_for_ams(state, serial)
+        .await
+        .ok_or_else(|| fail(format!("no MQTT status for {serial} (not subscribed / printer offline?)"), Value::Null, vec![]))?;
+
+    let ipcam = ipcam_of(&status);
+    let protocols = match protocols_override {
+        Some(p) if !p.is_empty() => p,
+        _ => protocols_from_ipcam(&ipcam),
+    };
+
+    // Firmware version: scraped info.module, else status fields, else ask the printer.
+    let mut dev_ver = state.camera.versions.read().unwrap().get(serial).cloned();
+    if dev_ver.is_none() {
+        dev_ver = extract_dev_ver(&status);
+    }
+    if dev_ver.is_none() {
+        let cmd = r#"{"info":{"sequence_id":"0","command":"get_version"}}"#;
+        let _ = state.handle.send_message(serial.to_string(), cmd.to_string()).await;
+        for _ in 0..50 {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            if let Some(v) = state.camera.versions.read().unwrap().get(serial).cloned() {
+                dev_ver = Some(v);
+                break;
+            }
+        }
+    }
+    let dev_ver = dev_ver.unwrap_or_default();
+
+    let dev_id = format!("{serial}|{dev_ver}|{}", protocols_wire(&protocols));
+    match state.handle.get_camera_url(dev_id, MINT_TIMEOUT).await {
+        Ok(url) => Ok(MintOk { url, dev_ver, protocols, ipcam }),
+        Err(e) => Err(fail(e, ipcam, protocols)),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Route: GET /camera/:serial/url
+// ---------------------------------------------------------------------------
+
+pub async fn camera_url(
+    State(state): State<SharedState>,
+    Path(serial): Path<String>,
+    Query(q): Query<HashMap<String, String>>,
+) -> Response {
+    let ov = q.get("protocols").map(|s| parse_protocol_override(s));
+    match mint(&state, &serial, ov).await {
+        Ok(m) => {
+            let prefix = url_prefix(&m.url);
+            Json(json!({
+                "ok": true,
+                "url_prefix": prefix,
+                "transport": transport_of(&prefix),
+                "protocols": m.protocols,
+                "dev_ver": m.dev_ver,
+                "ipcam": m.ipcam,
+                "error": Value::Null,
+            }))
+            .into_response()
+        }
+        Err(e) => (
+            StatusCode::BAD_GATEWAY,
+            Json(json!({
+                "ok": false,
+                "url_prefix": Value::Null,
+                "protocols": e.protocols,
+                "ipcam": e.ipcam,
+                "error": e.error,
+            })),
+        )
+            .into_response(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Snapshot
+// ---------------------------------------------------------------------------
+
+pub const STAGES: [&str; 8] = ["none", "dlopen", "create", "open", "start", "info", "read", "done"];
+
+pub fn stage_name(i: i32) -> &'static str {
+    STAGES.get(i as usize).copied().unwrap_or("unknown")
+}
+
+#[derive(Debug)]
+pub struct SnapOutcome {
+    pub ok: bool,
+    pub stage: i32,
+    pub code: i32,
+    pub err: String,
+    pub sub_type: i32,
+    pub format_type: i32,
+    pub width: i32,
+    pub height: i32,
+    pub frame_rate: i32,
+    pub flags: i32,
+    pub data: Vec<u8>,
+    pub fmt: Vec<u8>,
+    pub log: Vec<String>,
+}
+
+type LogBuf = Mutex<VecDeque<String>>;
+
+extern "C" fn snap_log_cb(ctx: *mut c_void, level: c_int, msg: *const c_char) {
+    if ctx.is_null() || msg.is_null() {
+        return;
+    }
+    let buf = unsafe { &*(ctx as *const LogBuf) };
+    let m = unsafe { CStr::from_ptr(msg).to_string_lossy().into_owned() };
+    let line = format!("[{level}] {}", redact(m.trim_end()));
+    let mut b = buf.lock().unwrap();
+    if b.len() >= LOG_KEEP {
+        b.pop_front();
+    }
+    b.push_back(line);
+}
+
+fn last_lines(log: &LogBuf) -> Vec<String> {
+    let b = log.lock().unwrap();
+    let skip = b.len().saturating_sub(LOG_RETURN);
+    b.iter().skip(skip).cloned().collect()
+}
+
+/// Run the BambuSource play loop on a dedicated thread. `url` is the full
+/// credentialed URL. Always returns; a hung library yields stage = last stage
+/// reached with code -999.
+pub async fn run_snapshot(lib_path: String, url: String, timeout: Duration) -> SnapOutcome {
+    let log: Arc<LogBuf> = Arc::new(Mutex::new(VecDeque::new()));
+    let stage: Arc<AtomicI32> = Arc::new(AtomicI32::new(0));
+    let (tx, rx) = oneshot::channel::<SnapOutcome>();
+
+    // One reference is handed to the C side as the logger context. It is only
+    // reclaimed after the helper returned; on a hang it is leaked on purpose
+    // because the library may still log from its own threads.
+    let log_ctx = Arc::into_raw(log.clone()) as usize;
+    let stage_t = stage.clone();
+    let log_t = log.clone();
+
+    let spawn = std::thread::Builder::new().name("bambu-snapshot".into()).spawn(move || {
+        let mut out = SnapOutcome {
+            ok: false, stage: 0, code: 0, err: String::new(), sub_type: 0, format_type: 0,
+            width: 0, height: 0, frame_rate: 0, flags: 0, data: vec![], fmt: vec![], log: vec![],
+        };
+        let (c_lib, c_url) = match (CString::new(lib_path), CString::new(url)) {
+            (Ok(a), Ok(b)) => (a, b),
+            _ => {
+                out.stage = 1;
+                out.code = -1;
+                out.err = "NUL byte in path/url".into();
+                let _ = tx.send(out);
+                return;
+            }
+        };
+        let mut r: ffi::ShimSnapResult = unsafe { std::mem::zeroed() };
+        unsafe {
+            ffi::shim_snapshot(
+                c_lib.as_ptr(),
+                c_url.as_ptr(),
+                timeout.as_millis() as c_int,
+                &mut r,
+                stage_t.as_ptr(),
+                snap_log_cb,
+                log_ctx as *mut c_void,
+            );
+        }
+        out.ok = r.ok != 0;
+        out.stage = r.stage;
+        out.code = r.code;
+        out.err = unsafe { CStr::from_ptr(r.err.as_ptr()).to_string_lossy().into_owned() };
+        out.sub_type = r.sub_type;
+        out.format_type = r.format_type;
+        out.width = r.width;
+        out.height = r.height;
+        out.frame_rate = r.frame_rate;
+        out.flags = r.sample_flags;
+        if !r.data.is_null() && r.data_len > 0 {
+            out.data = unsafe { std::slice::from_raw_parts(r.data, r.data_len as usize) }.to_vec();
+        }
+        if !r.fmt.is_null() && r.fmt_len > 0 {
+            out.fmt = unsafe { std::slice::from_raw_parts(r.fmt, r.fmt_len as usize) }.to_vec();
+        }
+        unsafe { ffi::shim_snapshot_free(&mut r) };
+        out.log = last_lines(&log_t);
+        // Reclaim the logger ref: the helper returned and cleared the logger.
+        // (The library might still hold the tunnel's logger pointer, but the
+        // shim's trampoline no longer forwards after return.)
+        unsafe { drop(Arc::from_raw(log_ctx as *const LogBuf)) };
+        let _ = tx.send(out);
+    });
+
+    if let Err(e) = spawn {
+        return SnapOutcome {
+            ok: false, stage: 1, code: -1, err: format!("cannot spawn helper thread: {e}"),
+            sub_type: 0, format_type: 0, width: 0, height: 0, frame_rate: 0, flags: 0,
+            data: vec![], fmt: vec![], log: vec![],
+        };
+    }
+
+    match tokio::time::timeout(timeout + HELPER_GRACE, rx).await {
+        Ok(Ok(o)) => o,
+        Ok(Err(_)) => SnapOutcome {
+            ok: false, stage: stage.load(Ordering::Acquire), code: -998,
+            err: "helper thread died (crash in library?)".into(),
+            sub_type: 0, format_type: 0, width: 0, height: 0, frame_rate: 0, flags: 0,
+            data: vec![], fmt: vec![], log: last_lines(&log),
+        },
+        Err(_) => SnapOutcome {
+            ok: false, stage: stage.load(Ordering::Acquire), code: -999,
+            err: format!("library call did not return within {}s", (timeout + HELPER_GRACE).as_secs()),
+            sub_type: 0, format_type: 0, width: 0, height: 0, frame_rate: 0, flags: 0,
+            data: vec![], fmt: vec![], log: last_lines(&log),
+        },
+    }
+}
+
+/// Studio's extra URL parameters (MediaPlayCtrl.cpp). `refresh_url` (a raw
+/// function pointer in Studio, only used by agora) is intentionally omitted.
+pub fn append_studio_params(
+    url: &str,
+    serial: &str,
+    net_ver: &str,
+    dev_ver: &str,
+    cli_id: &str,
+    cli_ver: &str,
+) -> String {
+    let sep = if url.contains('?') { '&' } else { '?' };
+    format!("{url}{sep}device={serial}&net_ver={net_ver}&dev_ver={dev_ver}&cli_id={cli_id}&cli_ver={cli_ver}")
+}
+
+fn has_nal_type(annexb: &[u8], t: u8) -> bool {
+    let mut i = 0;
+    while i + 3 < annexb.len() {
+        if annexb[i] == 0 && annexb[i + 1] == 0 && (annexb[i + 2] == 1) {
+            if i + 3 < annexb.len() && annexb[i + 3] & 0x1f == t {
+                return true;
+            }
+            i += 3;
+        } else if annexb[i] == 0 && annexb[i + 1] == 0 && annexb[i + 2] == 0 && i + 4 < annexb.len() && annexb[i + 3] == 1 {
+            if annexb[i + 4] & 0x1f == t {
+                return true;
+            }
+            i += 4;
+        } else {
+            i += 1;
+        }
+    }
+    false
+}
+
+/// SPS+PPS from avcC extradata as Annex-B, plus the NAL length-field size.
+fn avcc_param_sets(avcc: &[u8]) -> Option<(Vec<u8>, usize)> {
+    const SC: [u8; 4] = [0, 0, 0, 1];
+    if avcc.len() < 7 || avcc[0] != 1 {
+        return None;
+    }
+    let len_size = (avcc[4] & 3) as usize + 1;
+    let mut out = Vec::with_capacity(64);
+    let mut p = 5;
+    let nsps = (avcc[p] & 0x1f) as usize;
+    p += 1;
+    for _ in 0..nsps {
+        let l = u16::from_be_bytes([*avcc.get(p)?, *avcc.get(p + 1)?]) as usize;
+        p += 2;
+        out.extend_from_slice(&SC);
+        out.extend_from_slice(avcc.get(p..p + l)?);
+        p += l;
+    }
+    let npps = *avcc.get(p)? as usize;
+    p += 1;
+    for _ in 0..npps {
+        let l = u16::from_be_bytes([*avcc.get(p)?, *avcc.get(p + 1)?]) as usize;
+        p += 2;
+        out.extend_from_slice(&SC);
+        out.extend_from_slice(avcc.get(p..p + l)?);
+        p += l;
+    }
+    Some((out, len_size))
+}
+
+/// Append a length-prefixed (AVCC) sample to `out` as Annex-B NAL units.
+fn avcc_nals_to_annexb(sample: &[u8], len_size: usize, out: &mut Vec<u8>) -> Option<()> {
+    let mut i = 0;
+    while i < sample.len() {
+        let mut l = 0usize;
+        for k in 0..len_size {
+            l = (l << 8) | *sample.get(i + k)? as usize;
+        }
+        i += len_size;
+        out.extend_from_slice(&[0, 0, 0, 1]);
+        out.extend_from_slice(sample.get(i..i + l)?);
+        i += l;
+    }
+    Some(())
+}
+
+/// Convert an AVCC (length-prefixed) sample into Annex-B, prepending SPS/PPS
+/// from the avcC extradata. None when the data is malformed.
+pub fn avcc_to_annexb(avcc: &[u8], sample: &[u8]) -> Option<Vec<u8>> {
+    let (mut out, len_size) = avcc_param_sets(avcc)?;
+    out.reserve(sample.len());
+    avcc_nals_to_annexb(sample, len_size, &mut out)?;
+    Some(out)
+}
+
+/// Make the keyframe a self-contained Annex-B stream where possible.
+fn to_annexb(o: &SnapOutcome) -> Vec<u8> {
+    match o.format_type {
+        0 => avcc_to_annexb(&o.fmt, &o.data).unwrap_or_else(|| o.data.clone()),
+        1 => {
+            let fmt_is_annexb = o.fmt.starts_with(&[0, 0, 0, 1]) || o.fmt.starts_with(&[0, 0, 1]);
+            if fmt_is_annexb && !has_nal_type(&o.data, 7) {
+                let mut v = o.fmt.clone();
+                v.extend_from_slice(&o.data);
+                v
+            } else {
+                o.data.clone()
+            }
+        }
+        _ => o.data.clone(),
+    }
+}
+
+fn snap_error(stage: &str, code: i32, error: String, log: Vec<String>) -> Response {
+    (
+        StatusCode::BAD_GATEWAY,
+        Json(json!({
+            "error": error,
+            "stage": stage,
+            "code": code,
+            "log": log,
+        })),
+    )
+        .into_response()
+}
+
+/// Turn a finished play loop into an HTTP response.
+pub fn outcome_response(o: SnapOutcome) -> Response {
+    if !o.ok {
+        return snap_error(stage_name(o.stage), o.code, o.err, o.log);
+    }
+    let info = json!({
+        "width": o.width,
+        "height": o.height,
+        "sub_type": o.sub_type,
+        "format_type": o.format_type,
+        "frame_rate": o.frame_rate,
+        "flags": o.flags,
+    });
+    let (ctype, body) = if o.sub_type == 1 {
+        ("image/jpeg", o.data.clone())
+    } else {
+        ("video/h264", to_annexb(&o))
+    };
+    let mut resp = (StatusCode::OK, body).into_response();
+    let h = resp.headers_mut();
+    h.insert(header::CONTENT_TYPE, HeaderValue::from_static(ctype));
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    if let Ok(v) = HeaderValue::from_str(&info.to_string()) {
+        h.insert("x-stream-info", v);
+    }
+    resp
+}
+
+/// A live stream owns this printer's camera tunnel; fail fast instead of
+/// queueing behind a stream that may run for hours.
+fn busy_response() -> Response {
+    let mut r = snap_error("busy", -1, "a live stream is running for this printer".into(), vec![]);
+    *r.status_mut() = StatusCode::CONFLICT;
+    r
+}
+
+pub async fn camera_snapshot(
+    State(state): State<SharedState>,
+    Path(serial): Path<String>,
+    Query(q): Query<HashMap<String, String>>,
+) -> Response {
+    let ov = q.get("protocols").map(|s| parse_protocol_override(s));
+    let m = match mint(&state, &serial, ov).await {
+        Ok(m) => m,
+        Err(e) => return snap_error("mint", -1, e.error, vec![]),
+    };
+
+    let full = append_studio_params(
+        &m.url,
+        &serial,
+        &state.plugin_version,
+        &m.dev_ver,
+        &BambuAgent::stable_device_id(),
+        BAMBU_STUDIO_VERSION,
+    );
+
+    let slot = state.camera.slot(&serial);
+    let _guard = slot.lock.lock().await;
+    if slot.live.load(Ordering::Acquire) {
+        return busy_response();
+    }
+    let lib = state.camera.bambu_source_path();
+    tracing::info!(serial = %serial, lib = %lib, "snapshot: starting play loop");
+    let o = run_snapshot(lib, full, SNAPSHOT_TIMEOUT).await;
+    tracing::info!(
+        ok = o.ok,
+        stage = stage_name(o.stage),
+        code = o.code,
+        bytes = o.data.len(),
+        "snapshot: finished"
+    );
+    outcome_response(o)
+}
+
+// ---------------------------------------------------------------------------
+// Live stream
+// ---------------------------------------------------------------------------
+
+/// Frames buffered for a slow client (~1 s at 30 fps) before old ones are dropped.
+const LIVE_QUEUE_FRAMES: usize = 30;
+
+struct LiveShared {
+    queue: Mutex<VecDeque<Bytes>>,
+    notify: Notify,
+    done: AtomicBool,
+}
+
+/// Ends the body when the reader thread exits, however it exits.
+struct DoneOnDrop(Arc<LiveShared>);
+
+impl Drop for DoneOnDrop {
+    fn drop(&mut self) {
+        self.0.done.store(true, Ordering::Release);
+        self.0.notify.notify_one();
+    }
+}
+
+/// Dropped with the response body (client gone): tells the reader to stop.
+struct StopOnDrop(Arc<AtomicI32>);
+
+impl Drop for StopOnDrop {
+    fn drop(&mut self) {
+        self.0.store(1, Ordering::Release);
+    }
+}
+
+/// Clears the serial's live flag once the tunnel is closed.
+struct LiveFlag(Arc<SerialSlot>);
+
+impl Drop for LiveFlag {
+    fn drop(&mut self) {
+        self.0.live.store(false, Ordering::Release);
+    }
+}
+
+type FirstMsg = Result<Value, SnapOutcome>;
+
+/// Per-stream state used by the library callbacks (reader thread only).
+struct LiveCtx {
+    shared: Arc<LiveShared>,
+    first: Option<oneshot::Sender<FirstMsg>>,
+    info: Value,
+    sub_type: i32,
+    format_type: i32,
+    fmt: Vec<u8>,
+    /// Annex-B SPS+PPS and NAL length size, for avcC streams.
+    params: Vec<u8>,
+    len_size: usize,
+    bad_fmt: bool,
+    /// False until a keyframe went out (and again after a drop): deltas are useless then.
+    synced: bool,
+}
+
+impl LiveCtx {
+    /// Wire form of one sample; None to skip it.
+    fn frame(&mut self, s: &[u8], key: bool) -> Option<Bytes> {
+        if self.sub_type == 1 {
+            let mut v = format!("--frame\r\nContent-Type: image/jpeg\r\nContent-Length: {}\r\n\r\n", s.len()).into_bytes();
+            v.extend_from_slice(s);
+            v.extend_from_slice(b"\r\n");
+            return Some(v.into());
+        }
+        if !key && !self.synced {
+            return None;
+        }
+        let mut v = Vec::with_capacity(s.len() + self.params.len() + self.fmt.len());
+        match self.format_type {
+            0 => {
+                if key {
+                    v.extend_from_slice(&self.params);
+                }
+                avcc_nals_to_annexb(s, self.len_size, &mut v)?;
+            }
+            1 => {
+                let fmt_is_annexb = self.fmt.starts_with(&[0, 0, 0, 1]) || self.fmt.starts_with(&[0, 0, 1]);
+                if key && fmt_is_annexb && !has_nal_type(s, 7) {
+                    v.extend_from_slice(&self.fmt);
+                }
+                v.extend_from_slice(s);
+            }
+            _ => v.extend_from_slice(s),
+        }
+        Some(v.into())
+    }
+
+    fn push(&mut self, f: Bytes, key: bool) {
+        let mut q = self.shared.queue.lock().unwrap();
+        if q.len() >= LIVE_QUEUE_FRAMES {
+            if self.sub_type == 1 {
+                q.pop_front();
+            } else {
+                // Dropping single H.264 frames corrupts the picture: drop
+                // everything and resume at the next keyframe.
+                q.clear();
+                if !key {
+                    self.synced = false;
+                    return;
+                }
+            }
+        }
+        if key {
+            self.synced = true;
+        }
+        q.push_back(f);
+        drop(q);
+        if let Some(tx) = self.first.take() {
+            let _ = tx.send(Ok(self.info.clone()));
+        }
+        self.shared.notify.notify_one();
+    }
+}
+
+extern "C" fn live_info(ctx: *mut c_void, r: *const ffi::ShimSnapResult) -> c_int {
+    let c = unsafe { &mut *(ctx as *mut LiveCtx) };
+    let r = unsafe { &*r };
+    c.sub_type = r.sub_type;
+    c.format_type = r.format_type;
+    if !r.fmt.is_null() && r.fmt_len > 0 {
+        c.fmt = unsafe { std::slice::from_raw_parts(r.fmt, r.fmt_len as usize) }.to_vec();
+    }
+    c.info = json!({
+        "sub_type": r.sub_type,
+        "format_type": r.format_type,
+        "width": r.width,
+        "height": r.height,
+        "frame_rate": r.frame_rate,
+    });
+    if r.sub_type != 1 && r.format_type == 0 {
+        match avcc_param_sets(&c.fmt) {
+            Some((p, l)) => {
+                c.params = p;
+                c.len_size = l;
+            }
+            None => {
+                c.bad_fmt = true;
+                return 1;
+            }
+        }
+    }
+    0
+}
+
+extern "C" fn live_sample(ctx: *mut c_void, data: *const u8, size: c_int, flags: c_int) -> c_int {
+    let c = unsafe { &mut *(ctx as *mut LiveCtx) };
+    let s = unsafe { std::slice::from_raw_parts(data, size as usize) };
+    let key = flags & 1 != 0;
+    if let Some(f) = c.frame(s, key) {
+        c.push(f, key);
+    }
+    0
+}
+
+/// Start the play loop on its own thread. Resolves at the first frame (info
+/// for the response headers) or with the failure outcome; the frames follow in
+/// the returned queue.
+async fn start_live(
+    lib_path: String,
+    url: String,
+    timeout: Duration,
+    flag: LiveFlag,
+) -> Result<(Value, Arc<LiveShared>, Arc<AtomicI32>), SnapOutcome> {
+    let log: Arc<LogBuf> = Arc::new(Mutex::new(VecDeque::new()));
+    let stage = Arc::new(AtomicI32::new(0));
+    let stop = Arc::new(AtomicI32::new(0));
+    let shared = Arc::new(LiveShared { queue: Mutex::new(VecDeque::new()), notify: Notify::new(), done: AtomicBool::new(false) });
+    let (tx, rx) = oneshot::channel::<FirstMsg>();
+    let fail = |stage: i32, code: i32, err: String, log: Vec<String>| SnapOutcome {
+        ok: false, stage, code, err, sub_type: 0, format_type: 0, width: 0, height: 0,
+        frame_rate: 0, flags: 0, data: vec![], fmt: vec![], log,
+    };
+
+    // Logger ref handed to C: reclaimed after the shim returned (it stops
+    // forwarding before that), see run_snapshot.
+    let log_ctx = Arc::into_raw(log.clone()) as usize;
+    let (stage_t, log_t, stop_t, shared_t) = (stage.clone(), log.clone(), stop.clone(), shared.clone());
+
+    let spawn = std::thread::Builder::new().name("bambu-live".into()).spawn(move || {
+        let _flag = flag;
+        let _done = DoneOnDrop(shared_t.clone());
+        let mut ctx = LiveCtx {
+            shared: shared_t, first: Some(tx), info: Value::Null, sub_type: 0, format_type: 0,
+            fmt: vec![], params: vec![], len_size: 4, bad_fmt: false, synced: false,
+        };
+        let (c_lib, c_url) = match (CString::new(lib_path), CString::new(url)) {
+            (Ok(a), Ok(b)) => (a, b),
+            _ => {
+                unsafe { drop(Arc::from_raw(log_ctx as *const LogBuf)) };
+                if let Some(tx) = ctx.first.take() {
+                    let _ = tx.send(Err(fail(1, -1, "NUL byte in path/url".into(), vec![])));
+                }
+                return;
+            }
+        };
+        let mut r: ffi::ShimSnapResult = unsafe { std::mem::zeroed() };
+        unsafe {
+            ffi::shim_stream(
+                c_lib.as_ptr(), c_url.as_ptr(), timeout.as_millis() as c_int,
+                &mut r, stage_t.as_ptr(), stop_t.as_ptr(),
+                snap_log_cb, log_ctx as *mut c_void,
+                live_info, live_sample, &mut ctx as *mut LiveCtx as *mut c_void,
+            );
+        }
+        let err = unsafe { CStr::from_ptr(r.err.as_ptr()).to_string_lossy().into_owned() };
+        let (st, code) = (r.stage, r.code);
+        let ok = r.ok != 0;
+        unsafe { ffi::shim_snapshot_free(&mut r) };
+        let lines = last_lines(&log_t);
+        unsafe { drop(Arc::from_raw(log_ctx as *const LogBuf)) };
+        if let Some(tx) = ctx.first.take() {
+            // Nothing was sent: report why, as the snapshot route would.
+            let o = if ctx.bad_fmt {
+                fail(5, -6, "malformed avcC format buffer".into(), lines)
+            } else if ok {
+                fail(6, 1, "stream ended before a keyframe arrived".into(), lines)
+            } else {
+                fail(st, code, err, lines)
+            };
+            let _ = tx.send(Err(o));
+        } else if !ok {
+            tracing::warn!(stage = stage_name(st), code, "live: stream failed: {err}");
+        }
+    });
+    if let Err(e) = spawn {
+        return Err(fail(1, -1, format!("cannot spawn helper thread: {e}"), vec![]));
+    }
+
+    match tokio::time::timeout(timeout + HELPER_GRACE, rx).await {
+        Ok(Ok(Ok(info))) => Ok((info, shared, stop)),
+        Ok(Ok(Err(o))) => Err(o),
+        Ok(Err(_)) => Err(fail(stage.load(Ordering::Acquire), -998, "helper thread died (crash in library?)".into(), last_lines(&log))),
+        Err(_) => {
+            stop.store(1, Ordering::Release);
+            Err(fail(
+                stage.load(Ordering::Acquire), -999,
+                format!("library call did not return within {}s", (timeout + HELPER_GRACE).as_secs()),
+                last_lines(&log),
+            ))
+        }
+    }
+}
+
+pub async fn camera_live(
+    State(state): State<SharedState>,
+    Path(serial): Path<String>,
+    Query(q): Query<HashMap<String, String>>,
+) -> Response {
+    let ov = q.get("protocols").map(|s| parse_protocol_override(s));
+    let m = match mint(&state, &serial, ov).await {
+        Ok(m) => m,
+        Err(e) => return snap_error("mint", -1, e.error, vec![]),
+    };
+    let full = append_studio_params(
+        &m.url,
+        &serial,
+        &state.plugin_version,
+        &m.dev_ver,
+        &BambuAgent::stable_device_id(),
+        BAMBU_STUDIO_VERSION,
+    );
+
+    // Wait for an in-flight snapshot, then claim the serial under the lock.
+    let slot = state.camera.slot(&serial);
+    {
+        let _g = slot.lock.lock().await;
+        if slot.live.swap(true, Ordering::AcqRel) {
+            return busy_response();
+        }
+    }
+    let flag = LiveFlag(slot);
+
+    let lib = state.camera.bambu_source_path();
+    tracing::info!(serial = %serial, lib = %lib, "live: starting play loop");
+    let (info, shared, stop) = match start_live(lib, full, SNAPSHOT_TIMEOUT, flag).await {
+        Ok(x) => x,
+        Err(o) => {
+            tracing::info!(stage = stage_name(o.stage), code = o.code, "live: failed before first frame");
+            return snap_error(stage_name(o.stage), o.code, o.err, o.log);
+        }
+    };
+
+    let ctype = if info["sub_type"] == 1 { "multipart/x-mixed-replace; boundary=frame" } else { "video/h264" };
+    let guard = StopOnDrop(stop);
+    let stream = futures_util::stream::unfold((shared, guard), |(shared, guard)| async move {
+        loop {
+            let f = shared.queue.lock().unwrap().pop_front();
+            if let Some(f) = f {
+                return Some((Ok::<Bytes, std::convert::Infallible>(f), (shared, guard)));
+            }
+            if shared.done.load(Ordering::Acquire) {
+                // The thread pushes before setting `done`, so empty here means finished.
+                if shared.queue.lock().unwrap().is_empty() {
+                    return None;
+                }
+                continue;
+            }
+            shared.notify.notified().await;
+        }
+    });
+    let mut resp = (StatusCode::OK, Body::from_stream(stream)).into_response();
+    let h = resp.headers_mut();
+    h.insert(header::CONTENT_TYPE, HeaderValue::from_static(ctype));
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    if let Ok(v) = HeaderValue::from_str(&info.to_string()) {
+        h.insert("x-stream-info", v);
+    }
+    resp
+}
