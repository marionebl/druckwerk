+        std::fs::create_dir_all(&dir).unwrap();
+        let marker = dir.join("t10");
+        let _ = std::fs::remove_file(&marker);
+        let (_server, state) = test_server(&format!("{SECRET_URL}&mode=live_forever&marker={}", marker.display()));
+        let addr = serve_real(state).await;
+        let c = open_live(addr, "SER123").await;
+        assert!(marker_lines(&marker).is_empty(), "tunnel closed while client still connected");
+        drop(c);
+        let t0 = std::time::Instant::now();
+        while marker_lines(&marker) != ["close", "destroy"] && t0.elapsed() < Duration::from_secs(5) {
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+        println!("marker={:?} after {:?}", marker_lines(&marker), t0.elapsed());
+        assert_eq!(marker_lines(&marker), ["close", "destroy"]);
+        assert!(t0.elapsed() < Duration::from_secs(1), "took {:?}", t0.elapsed());
+    }
